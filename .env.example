NODE_ENV=development
PORT=3000

# Password berkarakter khusus (@ # /) harus di-URL-encode
DATABASE_URL="mysql://kilas:ganti_password_kuat@localhost:3306/kilas_db"

# String acak minimal 32 karakter
JWT_SECRET=isi_dengan_string_acak_minimal_32_karakter
JWT_EXPIRES_IN=90d

PUBLIC_BASE_URL=http://localhost:3000

MAX_IMAGE_MB=5
MAX_VIDEO_MB=25
MAX_MEDIA_PER_REPORT=5

ENABLE_CRON=true
REMINDER_CRON="0 16 * * *"
APP_TIMEZONE=Asia/Jakarta

FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
